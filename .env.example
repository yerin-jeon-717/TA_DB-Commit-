# ──────────────────────────────────────────────────────
#  리멤버 → 나인하이어 연동 파이프라인 환경 변수
#  이 파일을 복사해 .env 로 저장한 뒤 값을 입력하세요.
#  .env 파일은 Git에 포함되지 않습니다 (보안 정보 포함).
# ──────────────────────────────────────────────────────

# [필수] 리멤버 로그인 정보
# 리멤버 채용 관리 페이지(career.rememberapp.co.kr) 계정
REMEMBER_EMAIL=
REMEMBER_PASSWORD=

# [자동관리] 리멤버 API 인증 토큰
# 스크립트 실행 시 자동으로 발급/갱신됩니다. 직접 수정 불필요.
REMEMBER_AUTH_TOKEN=

# [선택] 다운로드 저장 경로 (기본값 권장)
OUTPUT_DIR=output/remember_applicants

# [참고] 나인하이어 식별 정보
# NineHire 설정 > API 키 메뉴에서 확인
NINEHIRE_API_KEY=
NINEHIRE_COMPANY_ID=f0b5bd00-4e82-11ec-be75-dd3d4f039103
